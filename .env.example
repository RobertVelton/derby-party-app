# Source the dashboard pulls from. One of: twinspires | scrapingbee | direct | mock
# `twinspires` hits the public JSON feed the kentuckyderby.com widget uses (recommended).
ODDS_SOURCE=twinspires

# Optional override for the JSON feed URL (config-id 10 = the live odds widget).
# TWINSPIRES_FEED_URL=https://tscom-content.netlify.app/bettingwidget/10.json

# Used by the scrapingbee adapter (fallback if twinspires feed is unreachable).
ODDS_TARGET_URL=https://www.kentuckyderby.com/wager/live-odds/
SCRAPINGBEE_API_KEY=

# Server-only fetch cache TTL (seconds). Match the client poll interval.
ODDS_CACHE_TTL_SECONDS=30
